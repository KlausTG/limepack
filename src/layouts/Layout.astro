---
import "../styles/global.css";
import limepackLogo from "../assets/limepackcouk-logo.webp";
import { Button } from "../components/ui/button";
import {
  PhoneIcon,
  SearchIcon,
  ShoppingCartIcon,
  CircleUserRoundIcon,
} from "lucide-react";

const navItems = [
  { label: "Products", href: "/" },
  { label: "Design options", href: "/design-options" },
  { label: "About us", href: "/about" },
  { label: "Contact", href: "/contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Custom printed plastic cups</title>
  </head>
  <body>
    <nav
      class="flex border-b border-gray-200 items-center gap-4 flex-row px-6 h-17 w-full"
    >
      <div class="flex flex-row flex-1">
        <img
          src={limepackLogo.src}
          alt="Limepack logo"
          class="h-7 md:h-auto w-auto"
        />
      </div>
      <ul
        class="list-none flex-row justify-center gap-4 text-gray-600 hidden lg:flex"
      >
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="hover:text-foreground pointer">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex flex-row justify-end gap-2 flex-1">
        <Button variant="secondary" size="lg" className="hidden md:flex">
          <PhoneIcon className="size-5" />
          20 4587 9763
        </Button>
        <Button variant="secondary" size="icon-lg" className="md:hidden flex">
          <PhoneIcon className="size-5" />
        </Button>
        <Button variant="secondary" size="icon-lg">
          <SearchIcon className="size-6" />
        </Button>
        <Button variant="secondary" size="icon-lg">
          <CircleUserRoundIcon className="size-6" />
        </Button>
        <Button variant="secondary" size="icon-lg">
          <ShoppingCartIcon className="size-6" />
        </Button>
      </div>
    </nav>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
